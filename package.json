{
  "name": "dsh-chat-search",
  "version": "1.0.1",
  "icon": "./assets/icon-180.png",
  "type": "module",
  "description": "Ctrl+F search inside the open conversation: in-text highlights, previous/next, a match list and a count that climbs as the scan goes. Nothing is expanded and the reading position stays put.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "harness-plugin",
    "harness-bundle",
    "search",
    "find-in-conversation",
    "ctrl-f"
  ],
  "license": "MIT",
  "author": "1834395550",
  "homepage": "https://github.com/1834395550/dsh-chat-search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1834395550/dsh-chat-search.git"
  },
  "bugs": {
    "url": "https://github.com/1834395550/dsh-chat-search/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "screenshots/*.png",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
